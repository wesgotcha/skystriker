# ================================================================ 构建产物
/build/
/build-*/
/cmake-build-*/
/dist/
# 注意：不要写 *.obj —— models/*/OBJ/*.obj 是 Wavefront 模型，不是编译产物
*.exe
!vendor/**/*.exe

# ================================================================ 运行时生成
/save.dat
/shots/live/
# 作战复盘录像（每局自动生成，本机自己看就够了，不进版本库）
/replays/

# ================================================================ 素材预处理产物
# tools/prep_assets.py 生成：剥离内嵌贴图后的 <名字>_mesh.gltf，
# 以及 Textures/opt/ 下预先缩放好的配色贴图。删掉游戏照样能跑（只是回到慢速路径）。
/models/*/*/glTF/*_mesh.gltf
/models/*/*/Textures/opt/

# ================================================================ 未参与运行的模型源格式
# 运行时只加载 glTF（Assets.cpp 的 ModelPath）＋ Textures/ 里的配色图。
# Blend 是 Blender 源文件，FBX / OBJ 是导出中间格式，三者都不进版本库。
/models/*/*/Blend/
/models/*/*/FBX/
/models/*/*/OBJ/

# ================================================================ 开发期临时文件
/vendor/raylib.zip
/vendor/smoke.cpp
/vendor/smoke.exe
/tools/*.exe
/tools/probe_*.png
/shots/_*

# ================================================================ Blender 自动备份
*.blend1
*.blend2

# ================================================================ Python
__pycache__/
*.py[cod]
.pytest_cache/

# ================================================================ 编辑器 / 助手本地状态
/.workbuddy-ai/
/.workbuddy/
/.vscode/
/.idea/
*.swp
*.swo

# ================================================================ 系统文件
Thumbs.db
Desktop.ini
.DS_Store
