# ================================================================ 构建产物
/build/
/build-*/
/cmake-build-*/
# 注意：不要写 *.obj —— models/*/OBJ/*.obj 是 Wavefront 模型，不是编译产物
*.exe
!vendor/**/*.exe

# ================================================================ 运行时生成
/save.dat
/shots/live/

# ================================================================ 素材预处理产物
# tools/prep_assets.py 生成：剥离内嵌贴图后的 <名字>_mesh.gltf，
# 以及 Textures/opt/ 下预先缩放好的配色贴图。删掉游戏照样能跑（只是回到慢速路径）。
/models/*/*/glTF/*_mesh.gltf
/models/*/*/Textures/opt/

# ================================================================ 开发期临时文件
/vendor/raylib.zip
/vendor/smoke.cpp
/vendor/smoke.exe
/tools/*.exe
/tools/probe_*.png
/shots/_*

# ================================================================ Blender 自动备份
*.blend1
*.blend2

# ================================================================ Python
__pycache__/
*.py[cod]
.pytest_cache/

# ================================================================ 编辑器 / 助手本地状态
/.workbuddy-ai/
/.vscode/
/.idea/
*.swp
*.swo

# ================================================================ 系统文件
Thumbs.db
Desktop.ini
.DS_Store
